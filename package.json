{
    "name": "shadow-translator",
    "version": "1.3.0",
    "description": "Shows the original text as a gray line under each paragraph Chrome translates. No network requests. Open source.",
    "main": "content.js",
    "scripts": {
        "build": "webpack",
        "watch": "webpack --watch --mode development",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/woohyun1031/Shadow-Translator.git"
    },
    "keywords": [
        "chrome-extension",
        "translation",
        "bilingual",
        "original-text",
        "chrome-translate",
        "manifest-v3",
        "privacy"
    ],
    "author": "woohyun1031 (https://github.com/woohyun1031)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/woohyun1031/Shadow-Translator/issues"
    },
    "homepage": "https://github.com/woohyun1031/Shadow-Translator#readme",
    "devDependencies": {
        "@types/chrome": "^0.2.5",
        "copy-webpack-plugin": "^14.0.0",
        "jsdom": "^29.1.1",
        "prettier": "^3.8.2",
        "ts-loader": "^9.6.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "webpack": "^5.105.4",
        "webpack-cli": "^7.0.2"
    }
}
