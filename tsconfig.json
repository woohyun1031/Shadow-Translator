{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": "./src",
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "types": ["chrome"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": false
    },
    "include": ["src/**/*.ts"]
}
